rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // This security rules file assumes the following data structures:
    //
    // 1. Collection: users/{userId}/recipes/{recipeId}
    //    Document ID: recipeId (matches data.id)
    //    Owner: Authenticated user whose UID == userId
    //    Required fields:
    //      - id: string (1..128 chars, immutable, must equal recipeId)
    //      - title: string (1..200 chars)
    //      - prepTimeMinutes: number (0..10000)
    //      - servings: int (1..100)
    //      - tags: list (0..50 items)
    //      - ingredients: list (0..200 items)
    //      - steps: list (0..100 items)
    //      - isWeekly: bool
    //      - createdAt: string (1..64 chars, immutable)
    //      - updatedAt: string (1..64 chars)
    //    Optional fields:
    //      - recipeNumber: string (0..100 chars)
    //      - subtitle: string (0..500 chars)
    //      - prepTimeRange: string (0..100 chars)
    //      - utensils: list (0..50 items)
    //      - stepDetails: list (0..100 items)
    //      - nutrition: list (0..50 items)
    //      - allergens: string (0..1000 chars)
    //      - imageFront: string (0..900000 chars, compressed Data URL)
    //      - imageBack: string (0..900000 chars, compressed Data URL)
    //      - notes: string (0..10000 chars)
    //
    // 2. Document: users/{userId}/meta/weeklyPlan
    //    Document ID: 'weeklyPlan'
    //    Owner: Authenticated user whose UID == userId
    //    Optional fields (subset of days of the week):
    //      - lundi, mardi, mercredi, jeudi, vendredi, samedi, dimanche: map (DayPlan)
    //        Each DayPlan map allows only keys: ['midi', 'soir', 'midiServings', 'soirServings']
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns the path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate required fields exist on the incoming document
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate that immutable fields were not modified on update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Validate a required string's type and length
    function isValidString(data, field, minLen, maxLen) {
      return data[field] is string &&
             data[field].size() >= minLen &&
             data[field].size() <= maxLen;
    }

    // Validate an optional string's type and length if present
    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) ||
             (data[field] is string &&
              data[field].size() >= minLen &&
              data[field].size() <= maxLen);
    }

    // Validate an optional list's type and max size if present
    function isValidOptionalList(data, field, maxSize) {
      return !(field in data) ||
             (data[field] is list && data[field].size() <= maxSize);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidRecipe(data, recipeId) {
      let requiredFields = [
        'id',
        'title',
        'prepTimeMinutes',
        'servings',
        'tags',
        'ingredients',
        'steps',
        'isWeekly',
        'createdAt',
        'updatedAt'
      ];
      let allowedFields = [
        'id',
        'recipeNumber',
        'title',
        'subtitle',
        'prepTimeMinutes',
        'prepTimeRange',
        'servings',
        'tags',
        'utensils',
        'ingredients',
        'steps',
        'stepDetails',
        'nutrition',
        'allergens',
        'imageFront',
        'imageBack',
        'notes',
        'isWeekly',
        'createdAt',
        'updatedAt'
      ];

      return hasRequiredFields(requiredFields) &&
             hasOnlyAllowedFields(allowedFields) &&
             isValidString(data, 'id', 1, 128) &&
             data.id == recipeId &&
             isValidString(data, 'title', 1, 200) &&
             data.prepTimeMinutes is number &&
             data.prepTimeMinutes >= 0 &&
             data.prepTimeMinutes <= 10000 &&
             data.servings is int &&
             data.servings >= 1 &&
             data.servings <= 100 &&
             data.tags is list &&
             data.tags.size() <= 50 &&
             data.ingredients is list &&
             data.ingredients.size() <= 200 &&
             data.steps is list &&
             data.steps.size() <= 100 &&
             data.isWeekly is bool &&
             isValidString(data, 'createdAt', 1, 64) &&
             isValidString(data, 'updatedAt', 1, 64) &&
             isValidOptionalString(data, 'recipeNumber', 0, 100) &&
             isValidOptionalString(data, 'subtitle', 0, 500) &&
             isValidOptionalString(data, 'prepTimeRange', 0, 100) &&
             isValidOptionalList(data, 'utensils', 50) &&
             isValidOptionalList(data, 'stepDetails', 100) &&
             isValidOptionalList(data, 'nutrition', 50) &&
             isValidOptionalString(data, 'allergens', 0, 1000) &&
             isValidOptionalString(data, 'imageFront', 0, 900000) &&
             isValidOptionalString(data, 'imageBack', 0, 900000) &&
             isValidOptionalString(data, 'notes', 0, 10000);
    }

    function isValidDaySlotValue(val) {
      return val == null || (val is string && val.size() >= 1 && val.size() <= 128);
    }

    function isValidDayPlan(dayData) {
      return dayData is map &&
             dayData.keys().hasOnly(['midi', 'soir', 'midiServings', 'soirServings']) &&
             (!('midi' in dayData) || isValidDaySlotValue(dayData.midi)) &&
             (!('soir' in dayData) || isValidDaySlotValue(dayData.soir)) &&
             (!('midiServings' in dayData) || (dayData.midiServings is int && dayData.midiServings >= 1 && dayData.midiServings <= 100)) &&
             (!('soirServings' in dayData) || (dayData.soirServings is int && dayData.soirServings >= 1 && dayData.soirServings <= 100));
    }

    function isValidDayIfPresent(data, dayKey) {
      return !(dayKey in data) || isValidDayPlan(data[dayKey]);
    }

    function isValidWeeklyPlan(data) {
      let allowedDays = [
        'lundi',
        'mardi',
        'mercredi',
        'jeudi',
        'vendredi',
        'samedi',
        'dimanche'
      ];

      return hasOnlyAllowedFields(allowedDays) &&
             isValidDayIfPresent(data, 'lundi') &&
             isValidDayIfPresent(data, 'mardi') &&
             isValidDayIfPresent(data, 'mercredi') &&
             isValidDayIfPresent(data, 'jeudi') &&
             isValidDayIfPresent(data, 'vendredi') &&
             isValidDayIfPresent(data, 'samedi') &&
             isValidDayIfPresent(data, 'dimanche');
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Per-user recipes collection
    match /users/{userId}/recipes/{recipeId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidRecipe(request.resource.data, recipeId);
      allow update: if isOwner(userId) &&
                       isValidRecipe(request.resource.data, recipeId) &&
                       areImmutableFieldsUnchanged(['id', 'createdAt']);
      allow delete: if isOwner(userId);
    }

    // Per-user weekly meal plan document
    match /users/{userId}/meta/weeklyPlan {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidWeeklyPlan(request.resource.data);
      allow update: if isOwner(userId) &&
                       isValidWeeklyPlan(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
